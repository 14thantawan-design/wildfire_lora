# พอร์ตที่ Backend ใช้เปิดรับ HTTP request
PORT=4000

# ที่อยู่ MongoDB และชื่อฐานข้อมูลที่ Backend จะเชื่อมต่อ
MONGODB_URI=mongodb://127.0.0.1:27017/wildfire_lora

# รหัสสำหรับยืนยันว่า HTTP request มาจาก Gateway ของระบบ
# ค่านี้ต้องตรงกับ GATEWAY_API_KEY ใน gateway/secrets.h
GATEWAY_API_KEY=replace-with-a-long-random-key

# รายชื่อเว็บไซต์ที่อนุญาตให้เรียก Backend API โดยตรง คั่นแต่ละ URL ด้วยเครื่องหมายจุลภาค
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://wildfire.nattaphat.me,https://admin.nattaphat.me

# ชื่อเว็บไซต์ Admin ที่ Cloudflare Access ป้องกันไว้
# Backend ตรวจลายเซ็น JWT จาก Cloudflare Access ส่วนรายชื่ออีเมล Admin
# ให้จัดการใน Access Policy ของ Cloudflare โดยไม่ต้องเก็บไว้ในไฟล์นี้
ADMIN_HOSTNAME=admin.nattaphat.me
CF_ACCESS_TEAM_DOMAIN=https://your-team-name.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-the-application-audience-tag

# ระยะเวลาที่ Backend รอข้อมูลจาก Gateway ก่อนแสดงว่า Gateway ไม่เชื่อมต่อ หน่วยมิลลิวินาที
GATEWAY_OFFLINE_TIMEOUT_MS=30000

# เวลาสำรองสำหรับตรวจว่าโหนดออฟไลน์ หน่วยมิลลิวินาที
# ใช้เฉพาะเมื่อโหนดนั้นยังไม่มีค่า report_interval_sec
OFFLINE_TIMEOUT_MS=60000

# การแจ้งเตือนผ่าน Telegram ปล่อย TOKEN และ CHAT_ID ว่างเพื่อปิดการแจ้งเตือน
# หากเป็น Channel สาธารณะ TELEGRAM_CHAT_ID สามารถใช้ชื่อ เช่น @WildfireLoraAlerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# URL หน้า Dashboard ที่แนบไปกับข้อความแจ้งเตือน และเขตเวลาที่ใช้แสดงเวลา
TELEGRAM_DASHBOARD_URL=https://wildfire.nattaphat.me
TELEGRAM_TIMEZONE=Asia/Bangkok
